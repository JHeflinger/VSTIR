#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

#define EPS 0.000001

layout(binding = 1) readonly buffer TriangleSSBOIn {
    Triangle triangleIn[ ];
};

layout(binding = 2) buffer BVHNodeSSBOIn {
    NodeBVH bvhIn[ ];
};

layout(binding = 3) readonly buffer NormalsSSBOIn {
    vec3 normalIn[ ];
};

layout(binding = 4) readonly buffer VertexSSBOIn {
    vec3 vertexIn[ ];
};

layout(binding = 5) buffer RayGeneratorSSBOIn {
   RayGenerator raygenIn[ ];
};

layout(binding = 6) readonly buffer MaterialsSSBOIn {
    Material materialIn[ ];
};

layout(binding = 7) readonly buffer PreviousRayGeneratorSSBOIn {
   RayGenerator previousRaygenIn[ ];
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#include "bvh.glsl"

const float PI = 3.14159265358979323846;
uvec4 seed = uvec4(0);

void init_random(int x, int y) {
    seed = uvec4(x, y, ubo.seed, x + y);
}

void pcg4d(inout uvec4 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.w;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v.w += v.y * v.z;
    v = v ^ (v >> 16u);
    v.x += v.y * v.w;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v.w += v.y * v.z;
}

float random() {
    pcg4d(seed);
    return float(seed.x) / float(0xffffffffu);
}

Ray create_ray(vec2 rg) {
	float r = ubo.width / 2.0;
	float b = ubo.height / 2.0;
	float l = -1.0 * r;
	float t = -1.0 * b;
    float u = l + ((r - l) * (float(rg.x) + 0.5)) / ubo.width;
    float v = b + ((t - b) * (float(rg.y) + 0.5)) / ubo.height;
	float d = (cos(ubo.fov / 2.0) / sin(ubo.fov / 2.0)) * r;
    Ray ray;
    ray.direction = normalize((ubo.u * u) + (ubo.v * v) - (ubo.w * d));
    ray.position = ubo.position;
    return ray;
}

vec3 lambertian_throughput(in vec3 outgoing, in vec3 normal, in vec3 incoming, in Material material) {
    return ((material.diffuse / PI) +
        (material.specular * (material.shiny + 2.0) /
        (2.0 * PI) * pow(max(dot(reflect(-outgoing, normal), incoming), 0.0), material.shiny))) *
        max(0.0, dot(incoming, normal));
}

float luminance(vec3 c) {
    return 0.2126*c.x + 0.7152*c.y + 0.0722*c.z;
}

bool finite_vec3(vec3 v) {
    return !any(isnan(v)) && !any(isinf(v));
}

bool right_side() {
    int x = int(gl_GlobalInvocationID.x % uint(ubo.width));
    int y = int(gl_GlobalInvocationID.x / uint(ubo.width));
    return restir_divider_right_side_pixel(x, y);
}

bool restir_enabled() {
    return (right_side() ? ubo.restirright : ubo.restir) != 0;
}

float diffuse_pdf(vec3 normal, vec3 incoming) {
    return max(0.0, dot(normal, incoming)) / PI;
}

float specular_pdf(vec3 incoming, vec3 R, float shiny) {
    float cosalpha = max(dot(R, incoming), 0.0);
    return (shiny + 1.0) * pow(cosalpha, shiny) / (2.0 * PI);
}

float target_luminance_at_visible(vec3 x_v, vec3 n_v, uint material_index, vec3 x_s, vec3 Lo) {
    if (length(x_s - x_v) <= EPS) return 0.0;
    return restir_contribution_target_luminance(x_v, n_v, x_s, Lo, materialIn[material_index]);
}

void clear_temporal(inout RayGenerator rg) {
    rg.temporal_x_v = vec3(0.0);
    rg.temporal_n_v = vec3(0.0);
    rg.temporal_x_s = vec3(0.0);
    rg.temporal_n_s = vec3(0.0);
    rg.temporal_Lo = vec3(0.0);
    rg.temporal_w = 0.0;
    rg.temporal_M = 0;
    rg.temporal_W = 0.0;
    rg.temporal_flags = 0;
}

bool exportable_flags(uint flags) {
    uint required = RESTIR_FLAG_EXPORTABLE | RESTIR_FLAG_DIFFUSE_REUSE;
    return (flags & required) == required;
}

bool valid_temporal_history(RayGenerator rg) {
    return rg.temporal_M > 0 &&
        rg.temporal_W > 0.0 &&
        exportable_flags(rg.temporal_flags) &&
        restir_valid_radiance(rg.temporal_Lo) &&
        length(rg.temporal_n_v) > EPS &&
        length(rg.temporal_n_s) > EPS &&
        length(rg.temporal_x_s - rg.temporal_x_v) > EPS;
}

bool reproject_pixel(vec3 world_position, out uint pixel_index) {
    vec4 clip = ubo.previousvpm * vec4(world_position, 1.0);
    if (clip.w <= EPS) return false;
    vec3 ndc = clip.xyz / clip.w;
    if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0 || ndc.z < -1.0 || ndc.z > 1.0) {
        return false;
    }
    ivec2 pixel = ivec2((ndc.xy * 0.5 + 0.5) * vec2(ubo.width, ubo.height));
    if (pixel.x < 0 || pixel.x >= int(ubo.width) || pixel.y < 0 || pixel.y >= int(ubo.height)) return false;
    pixel_index = uint(pixel.y) * uint(ubo.width) + uint(pixel.x);
    return true;
}

float reprojection_world_tolerance(float current_depth) {
    float pixel_footprint = 2.0 * current_depth * tan(ubo.fov * 0.5) / max(ubo.width, 1.0);
    return max(4.0 * pixel_footprint, 1e-4);
}

vec3 offset_ray_origin(vec3 position, vec3 normal, vec3 direction) {
    return position + normal * (dot(normal, direction) >= 0.0 ? EPS : -EPS);
}

bool visible_reconnection(vec3 x_v, vec3 n_v, vec3 x_s) {
    vec3 delta = x_s - x_v;
    float sample_dist = length(delta);
    if (sample_dist <= EPS) return false;
    vec3 direction = delta / sample_dist;
    Ray ray = { restir_offset_ray_origin(x_v, n_v, direction), direction };
    return !traceAny(ray, sample_dist - EPS);
}

bool valid_gi_sample_for_surface(vec3 x_v, vec3 n_v, uint material_index, vec3 x_s, vec3 n_s, vec3 Lo) {
    if (!finite_vec3(x_s) || !finite_vec3(n_s) || length(n_s) <= EPS) return false;
    if (target_luminance_at_visible(x_v, n_v, material_index, x_s, Lo) <= EPS) return false;
    return visible_reconnection(x_v, n_v, x_s);
}

bool compatible_reprojected_history(RayGenerator current, RayGenerator history) {
    if (ubo.resetreservoirs != 0 || ubo.restirframes == 0) return false;
    if (!valid_temporal_history(history)) return false;
    if (current.initial_mat != history.initial_mat) return false;
    if (dot(current.initial_n_v, history.temporal_n_v) < ubo.normalthreshold) return false;
    float current_depth = length(current.initial_x_v - ubo.position);
    if (current_depth <= EPS) return false;
    float world_delta = length(current.initial_x_v - history.temporal_x_v);
    if (world_delta > reprojection_world_tolerance(current_depth)) return false;
    return true;
}

void merge_temporal_candidate(
    inout RayGenerator rg,
    vec3 target_x_v,
    vec3 target_n_v,
    vec3 candidate_x_s,
    vec3 candidate_n_s,
    vec3 candidate_Lo,
    float candidate_weight,
    uint candidate_M,
    uint candidate_flags) {
    if (candidate_weight <= EPS || candidate_M == 0u || isnan(candidate_weight) || isinf(candidate_weight)) return;
    uint original_M = candidate_M;
    candidate_M = min(candidate_M, max(ubo.temporal_m_cap, 1u));
    candidate_weight *= float(candidate_M) / float(original_M);
    rg.temporal_w += candidate_weight;
    rg.temporal_M += candidate_M;
    if (random() < candidate_weight / rg.temporal_w) {
        rg.temporal_x_v = target_x_v;
        rg.temporal_n_v = target_n_v;
        rg.temporal_x_s = candidate_x_s;
        rg.temporal_n_s = candidate_n_s;
        rg.temporal_Lo = candidate_Lo;
        rg.temporal_flags = candidate_flags;
    }
}

void temporal_resample() {
    RayGenerator rg = raygenIn[gl_GlobalInvocationID.x];
    clear_temporal(rg);
    if (ubo.resetreservoirs != 0 || length(rg.initial_n_v) <= EPS) {
        raygenIn[gl_GlobalInvocationID.x] = rg;
        return;
    }

    float initial_phat = target_luminance_at_visible(rg.initial_x_v, rg.initial_n_v, rg.initial_mat, rg.initial_x_s, rg.initial_Lo);
    if (rg.initial_pdf > EPS && initial_phat > EPS && finite_vec3(rg.initial_Lo)) {
        merge_temporal_candidate(
            rg,
            rg.initial_x_v,
            rg.initial_n_v,
            rg.initial_x_s,
            rg.initial_n_s,
            rg.initial_Lo,
            initial_phat / rg.initial_pdf,
            1u,
            rg.initial_flags);
    }

    uint history_index = 0u;
    if (reproject_pixel(rg.initial_x_v, history_index)) {
        RayGenerator history = previousRaygenIn[history_index];
        if (compatible_reprojected_history(rg, history) &&
            valid_gi_sample_for_surface(
                rg.initial_x_v,
                rg.initial_n_v,
                rg.initial_mat,
                history.temporal_x_s,
                history.temporal_n_s,
                history.temporal_Lo)) {
            float phat = target_luminance_at_visible(
                rg.initial_x_v,
                rg.initial_n_v,
                rg.initial_mat,
                history.temporal_x_s,
                history.temporal_Lo);
            float jacobian_correction = restir_reconnection_correction(
                history.temporal_x_v,
                rg.initial_x_v,
                history.temporal_x_s,
                history.temporal_n_s);
            if (phat > EPS && jacobian_correction > EPS) {
                merge_temporal_candidate(
                    rg,
                    rg.initial_x_v,
                    rg.initial_n_v,
                    history.temporal_x_s,
                    history.temporal_n_s,
                    history.temporal_Lo,
                    (phat * jacobian_correction) * history.temporal_W * float(history.temporal_M),
                    history.temporal_M,
                    history.temporal_flags);
            }
        }
    }

    if (rg.temporal_M > ubo.temporal_m_cap) {
        float oldM = float(rg.temporal_M);
        rg.temporal_M = max(ubo.temporal_m_cap, 1u);
        rg.temporal_w *= float(rg.temporal_M) / oldM;
    }
    float phat_z = target_luminance_at_visible(rg.initial_x_v, rg.initial_n_v, rg.initial_mat, rg.temporal_x_s, rg.temporal_Lo);
    if (rg.temporal_M == 0 || phat_z <= EPS || rg.temporal_w <= EPS || !finite_vec3(rg.temporal_Lo)) {
        rg.temporal_W = 0.0;
        rg.temporal_flags = 0u;
    } else {
        rg.temporal_W = rg.temporal_w / (float(rg.temporal_M) * phat_z);
    }
    raygenIn[gl_GlobalInvocationID.x] = rg;
}

void main() {
    uint pixelCount = uint(ubo.width) * uint(ubo.height);
    if (gl_GlobalInvocationID.x >= pixelCount) return;
    int rx = int(gl_GlobalInvocationID.x%int(ubo.width));
    int ry = int(gl_GlobalInvocationID.x/int(ubo.width));
    init_random(rx, ry);
    if (!restir_enabled()) return;
    temporal_resample();
}
