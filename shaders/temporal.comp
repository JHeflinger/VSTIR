#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

#define MAX_RECURSIVE_DEPTH 2000
#define EPS 0.000001

layout(binding = 1) readonly buffer TriangleSSBOIn {
    Triangle triangleIn[ ];
};

layout(binding = 2) buffer BVHNodeSSBOIn {
    NodeBVH bvhIn[ ];
};

layout(binding = 3) readonly buffer NormalsSSBOIn {
    vec3 normalIn[ ];
};

layout(binding = 4) readonly buffer VertexSSBOIn {
    vec3 vertexIn[ ];
};

layout(binding = 5) buffer RayGeneratorSSBOIn {
   RayGenerator raygenIn[ ];
};

layout(binding = 6) readonly buffer MaterialsSSBOIn {
    Material materialIn[ ];
};

layout(binding = 7) readonly buffer PreviousRayGeneratorSSBOIn {
   RayGenerator previousRaygenIn[ ];
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const float max_contribution = 10;
const float MAX_RECONNECTION_JACOBIAN = 10.0;
const uint RESERVOIR_FLAG_EXPORTABLE = 1u;
const float PI = 3.14159265358979323846;
uvec4 seed = uvec4(0);

void init_random(int x, int y) {
    seed = uvec4(x, y, ubo.seed, x + y);
}

void pcg4d(inout uvec4 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.w;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v.w += v.y * v.z;
    v = v ^ (v >> 16u);
    v.x += v.y * v.w;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v.w += v.y * v.z;
}

float random() {
    pcg4d(seed);
    return float(seed.x) / float(0xffffffffu);
}

Ray create_ray(vec2 rg) {
	float r = ubo.width / 2.0;
	float b = ubo.height / 2.0;
	float l = -1.0 * r;
	float t = -1.0 * b;
    float u = l + ((r - l) * (float(rg.x) + 0.5)) / ubo.width;
    float v = b + ((t - b) * (float(rg.y) + 0.5)) / ubo.height;
	float d = (cos(ubo.fov / 2.0) / sin(ubo.fov / 2.0)) * r;
    Ray ray;
    ray.direction = normalize((ubo.u * u) + (ubo.v * v) - (ubo.w * d));
    ray.position = ubo.position;
    return ray;
}

bool triangle_intersect(Ray ray, uint triangle_ind, inout Hit hit) {
    Triangle tri = triangleIn[triangle_ind];
    vec3 _a = vertexIn[tri.a];
    vec3 _b = vertexIn[tri.b];
    vec3 _c = vertexIn[tri.c];
    vec3 e1 = _b - _a;
    vec3 e2 = _c - _a;
    vec3 h = cross(ray.direction, e2);
    float a = dot(e1, h);
    if (abs(a) < EPS) return false;
    float f = 1.0 / a;
    vec3 s = ray.position - _a;
    float u = f*dot(s, h);
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(s, e1);
    float v = f*dot(ray.direction, q);
    if (v < 0.0 || u + v > 1.0) return false;
    hit.distance = f * dot(e2, q);
    if (hit.distance <= EPS) return false;
    hit.material = tri.material;
    hit.position = ray.position + (ray.direction * hit.distance);
    if (tri.an != -1) hit.normal = normalize((1.0 - u - v)*normalIn[tri.an] + u*normalIn[tri.bn] + v*normalIn[tri.cn]);
    else hit.normal = normalize(cross(e1, e2));
    if (dot(hit.normal, -ray.direction) < 0.0) hit.normal = -hit.normal;
    return true;
}

bool aabb_intersect(Ray ray, uint node_ind) {
	vec3 dfrac = 1.0 / ray.direction;
    vec3 mindif = (bvhIn[node_ind].min - ray.position)*dfrac;
    vec3 maxdif = (bvhIn[node_ind].max - ray.position)*dfrac;
	float tmin = max(max(min(mindif.x, maxdif.x), min(mindif.y, maxdif.y)), min(mindif.z, maxdif.z));
	float tmax = min(min(max(mindif.x, maxdif.x), max(mindif.y, maxdif.y)), max(mindif.z, maxdif.z));
    return tmax >= 0 && tmin <= tmax;
}

Hit trace(Ray ray, inout uint hit_id) {
    Hit hit;
    hit.distance = -1.0;
    hit.material = 0;
    hit.normal = vec3(0.0);
    hit.position = vec3(0.0);
    if (ubo.triangles == 0) return hit;
    if (!aabb_intersect(ray, 0)) return hit;
    uint stack[MAX_RECURSIVE_DEPTH];
    int stack_ptr = 0;
    stack[stack_ptr++] = 0;
    while (stack_ptr > 0) {
        NodeBVH node = bvhIn[stack[--stack_ptr]];
        if (stack_ptr >= MAX_RECURSIVE_DEPTH - 1) { break; }
        if (node.config == 0) {
            Hit trihit;
            if (triangle_intersect(ray, node.left, trihit)) {
                if (hit.distance == -1.0 || trihit.distance < hit.distance) {
                    hit = trihit;
					hit_id = node.left;
                }
            }
        } else if (node.config == 1) {
            if (aabb_intersect(ray, node.left))
                stack[stack_ptr++] = node.left;
        } else if (node.config == 2) {
            if (aabb_intersect(ray, node.right))
                stack[stack_ptr++] = node.right;
        } else {
            if (aabb_intersect(ray, node.left))
                stack[stack_ptr++] = node.left;
            if (aabb_intersect(ray, node.right))
                stack[stack_ptr++] = node.right;
        }
    }
    return hit;
}

vec3 lambertian_throughput(in vec3 outgoing, in vec3 normal, in vec3 incoming, in Material material) {
    return ((material.diffuse / PI) +
        (material.specular * (material.shiny + 2.0) /
        (2.0 * PI) * pow(max(dot(reflect(-outgoing, normal), incoming), 0.0), material.shiny))) *
        max(0.0, dot(incoming, normal));
}

float luminance(vec3 c) {
    return 0.2126*c.x + 0.7152*c.y + 0.0722*c.z;
}

bool finite_vec3(vec3 v) {
    return !any(isnan(v)) && !any(isinf(v));
}

bool right_side() {
    return ubo.showdivider != 0 && int(gl_GlobalInvocationID.x % uint(ubo.width)) > int(ubo.divider);
}

bool restir_enabled() {
    return (right_side() ? ubo.restirright : ubo.restir) != 0;
}

float diffuse_pdf(vec3 normal, vec3 incoming) {
    return max(0.0, dot(normal, incoming)) / PI;
}

float specular_pdf(vec3 incoming, vec3 R, float shiny) {
    float cosalpha = max(dot(R, incoming), 0.0);
    return (shiny + 1.0) * pow(cosalpha, shiny) / (2.0 * PI);
}

float target_luminance_at_visible(vec3 x_v, vec3 n_v, uint material_index, vec3 x_s, vec3 Lo) {
    if (!finite_vec3(Lo) || luminance(Lo) <= EPS) return 0.0;
    vec3 to_sample = x_s - x_v;
    if (length(to_sample) <= EPS) return luminance(Lo);
    vec3 to_view = ubo.position - x_v;
    if (length(to_view) <= EPS) return 0.0;
    vec3 wi = normalize(to_sample);
    vec3 wo = normalize(to_view);
    vec3 f = lambertian_throughput(wo, n_v, wi, materialIn[material_index]) * Lo;
    if (!finite_vec3(f)) return 0.0;
    return luminance(f);
}

float reconnection_jacobian(vec3 source_x_v, vec3 target_x_v, vec3 x_s, vec3 n_s) {
    vec3 source_delta = source_x_v - x_s;
    vec3 target_delta = target_x_v - x_s;
    float source_dist = length(source_delta);
    float target_dist = length(target_delta);
    if (source_dist <= EPS || target_dist <= EPS) return 0.0;
    vec3 source_dir = source_delta / source_dist;
    vec3 target_dir = target_delta / target_dist;
    float source_cos = clamp(abs(dot(n_s, source_dir)), 0.0, 1.0);
    float target_cos = clamp(abs(dot(n_s, target_dir)), 0.0, 1.0);
    if (source_cos <= EPS || target_cos <= EPS) return 0.0;
    float J = (source_dist * source_dist) / (target_dist * target_dist) * (target_cos / source_cos);
    if (J > MAX_RECONNECTION_JACOBIAN) return 0.0;
    return (J > EPS && !isnan(J) && !isinf(J)) ? J : 0.0;
}

void clear_temporal(inout RayGenerator rg) {
    rg.temporal_x_v = vec3(0.0);
    rg.temporal_n_v = vec3(0.0);
    rg.temporal_x_s = vec3(0.0);
    rg.temporal_n_s = vec3(0.0);
    rg.temporal_Lo = vec3(0.0);
    rg.temporal_w = 0.0;
    rg.temporal_M = 0;
    rg.temporal_W = 0.0;
    rg.temporal_flags = 0;
}

bool valid_spatial_history(RayGenerator rg) {
    return rg.spatial_M > 0 &&
        rg.spatial_W > 0.0 &&
        (rg.spatial_flags & RESERVOIR_FLAG_EXPORTABLE) != 0u &&
        finite_vec3(rg.spatial_Lo) &&
        luminance(rg.spatial_Lo) > EPS &&
        length(rg.spatial_n_v) > EPS &&
        length(rg.spatial_n_s) > EPS &&
        length(rg.spatial_x_s - rg.spatial_x_v) > EPS;
}

bool reproject_pixel(vec3 world_position, out uint pixel_index) {
    vec4 clip = ubo.previousvpm * vec4(world_position, 1.0);
    if (clip.w <= EPS) return false;
    vec3 ndc = clip.xyz / clip.w;
    if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0 || ndc.z < -1.0 || ndc.z > 1.0) {
        return false;
    }
    ivec2 pixel = ivec2((ndc.xy * 0.5 + 0.5) * vec2(ubo.width, ubo.height));
    if (pixel.x < 0 || pixel.x >= int(ubo.width) || pixel.y < 0 || pixel.y >= int(ubo.height)) return false;
    pixel_index = uint(pixel.y) * uint(ubo.width) + uint(pixel.x);
    return true;
}

float reprojection_world_tolerance(float current_depth) {
    float pixel_footprint = 2.0 * current_depth * tan(ubo.fov * 0.5) / max(ubo.width, 1.0);
    return max(4.0 * pixel_footprint, 1e-4);
}

vec3 offset_ray_origin(vec3 position, vec3 normal, vec3 direction) {
    return position + normal * (dot(normal, direction) >= 0.0 ? EPS : -EPS);
}

bool visible_reconnection(vec3 x_v, vec3 n_v, vec3 x_s) {
    vec3 delta = x_s - x_v;
    float sample_dist = length(delta);
    if (sample_dist <= EPS) return false;
    vec3 direction = delta / sample_dist;
    Ray ray = { offset_ray_origin(x_v, n_v, direction), direction };
    uint hit_id = -1;
    Hit hit = trace(ray, hit_id);
    return hit.distance <= 0.0 || hit.distance >= sample_dist - EPS;
}

bool valid_gi_sample_for_surface(vec3 x_v, vec3 n_v, uint material_index, vec3 x_s, vec3 n_s, vec3 Lo) {
    if (!finite_vec3(x_s) || !finite_vec3(n_s) || length(n_s) <= EPS) return false;
    if (target_luminance_at_visible(x_v, n_v, material_index, x_s, Lo) <= EPS) return false;
    return visible_reconnection(x_v, n_v, x_s);
}

bool compatible_reprojected_history(RayGenerator current, RayGenerator history) {
    if (ubo.resetreservoirs != 0 || ubo.restirframes == 0) return false;
    if (!valid_spatial_history(history)) return false;
    if (current.initial_mat != history.initial_mat) return false;
    if (dot(current.initial_n_v, history.spatial_n_v) < ubo.normalthreshold) return false;
    float current_depth = length(current.initial_x_v - ubo.position);
    if (current_depth <= EPS) return false;
    float world_delta = length(current.initial_x_v - history.spatial_x_v);
    if (world_delta > reprojection_world_tolerance(current_depth)) return false;
    return true;
}

void merge_temporal_candidate(
    inout RayGenerator rg,
    vec3 target_x_v,
    vec3 target_n_v,
    vec3 candidate_x_s,
    vec3 candidate_n_s,
    vec3 candidate_Lo,
    float candidate_weight,
    uint candidate_M,
    uint candidate_flags) {
    if (candidate_weight <= EPS || candidate_M == 0u || isnan(candidate_weight) || isinf(candidate_weight)) return;
    candidate_M = min(candidate_M, max(ubo.contributioncap, 1u));
    rg.temporal_w += candidate_weight;
    rg.temporal_M += candidate_M;
    if (random() < candidate_weight / rg.temporal_w) {
        rg.temporal_x_v = target_x_v;
        rg.temporal_n_v = target_n_v;
        rg.temporal_x_s = candidate_x_s;
        rg.temporal_n_s = candidate_n_s;
        rg.temporal_Lo = candidate_Lo;
        rg.temporal_flags = candidate_flags;
    }
}

void temporal_resample() {
    RayGenerator rg = raygenIn[gl_GlobalInvocationID.x];
    clear_temporal(rg);
    if (ubo.resetreservoirs != 0 || length(rg.initial_n_v) <= EPS) {
        raygenIn[gl_GlobalInvocationID.x] = rg;
        return;
    }

    float initial_phat = target_luminance_at_visible(rg.initial_x_v, rg.initial_n_v, rg.initial_mat, rg.initial_x_s, rg.initial_Lo);
    if (rg.initial_pdf > EPS && initial_phat > EPS && finite_vec3(rg.initial_Lo)) {
        merge_temporal_candidate(
            rg,
            rg.initial_x_v,
            rg.initial_n_v,
            rg.initial_x_s,
            rg.initial_n_s,
            rg.initial_Lo,
            initial_phat / rg.initial_pdf,
            1u,
            rg.initial_flags);
    }

    uint history_index = 0u;
    if (reproject_pixel(rg.initial_x_v, history_index)) {
        RayGenerator history = previousRaygenIn[history_index];
        if (compatible_reprojected_history(rg, history) &&
            valid_gi_sample_for_surface(
                rg.initial_x_v,
                rg.initial_n_v,
                rg.initial_mat,
                history.spatial_x_s,
                history.spatial_n_s,
                history.spatial_Lo)) {
            float phat = target_luminance_at_visible(
                rg.initial_x_v,
                rg.initial_n_v,
                rg.initial_mat,
                history.spatial_x_s,
                history.spatial_Lo);
            float J = reconnection_jacobian(
                history.spatial_x_v,
                rg.initial_x_v,
                history.spatial_x_s,
                history.spatial_n_s);
            if (phat > EPS && J > EPS) {
                merge_temporal_candidate(
                    rg,
                    rg.initial_x_v,
                    rg.initial_n_v,
                    history.spatial_x_s,
                    history.spatial_n_s,
                    history.spatial_Lo,
                    (phat * J) * history.spatial_W * float(history.spatial_M),
                    history.spatial_M,
                    history.spatial_flags);
            }
        }
    }

    if (rg.temporal_M > ubo.contributioncap) {
        float oldM = float(rg.temporal_M);
        rg.temporal_M = ubo.contributioncap;
        rg.temporal_w *= float(rg.temporal_M) / oldM;
    }
    float phat_z = target_luminance_at_visible(rg.initial_x_v, rg.initial_n_v, rg.initial_mat, rg.temporal_x_s, rg.temporal_Lo);
    if (rg.temporal_M == 0 || phat_z <= EPS || rg.temporal_w <= EPS || !finite_vec3(rg.temporal_Lo)) {
        rg.temporal_W = 0.0;
        rg.temporal_flags = 0u;
    } else {
        rg.temporal_W = rg.temporal_w / (float(rg.temporal_M) * phat_z);
    }
    raygenIn[gl_GlobalInvocationID.x] = rg;
}

void main() {
    uint pixelCount = uint(ubo.width) * uint(ubo.height);
    if (gl_GlobalInvocationID.x >= pixelCount) return;
    int rx = int(gl_GlobalInvocationID.x%int(ubo.width));
    int ry = int(gl_GlobalInvocationID.x/int(ubo.width));
    init_random(rx, ry);
    if (!restir_enabled()) return;
    temporal_resample();
}
