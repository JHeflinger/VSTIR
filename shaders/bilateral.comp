#version 450

#define EPS 0.000001

struct RayGenerator {
    vec3 rawaccumulation;
    vec3 accumulation;
    vec3 initial_x_v;
    vec3 initial_n_v;
    vec3 initial_x_s;
    vec3 initial_n_s;
    vec3 initial_Lo;
    float initial_pdf;
    uint initial_mat;
    vec3 temporal_x_v;
    vec3 temporal_n_v;
    vec3 temporal_x_s;
    vec3 temporal_n_s;
    vec3 temporal_Lo;
    float temporal_w;
    uint temporal_M;
    float temporal_W;
    vec3 spacial_x_v;
    vec3 spacial_n_v;
    vec3 spacial_x_s;
    vec3 spacial_n_s;
    vec3 spacial_Lo;
    float spacial_w;
    uint spacial_M;
    float spacial_W;
    vec3 direct;
};

struct Material {
    vec3 emission;
    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
    vec3 absorbtion;
    vec3 dispersion;
    float ior;
    float shiny;
    uint model;
};

layout(binding = 0) uniform UniformBufferObject {
    vec3 look;
    vec3 position;
    vec3 up;
    vec3 u;
    vec3 v;
    vec3 w;
    uint triangles;
    uint seed;
    uint samples;
    float fov;
    float width;
    float height;
    mat4 previousvpm;
    float depththreshold;
    float normalthreshold;
    uint contributioncap;
    uint candidatecap;
    uint spacerange;
    uint spacecount;
    uint emissivecount;
    uint directlighting;
    uint divider;
    uint filters;
} ubo;

layout(binding = 1) buffer RayGeneratorSSBOIn {
   RayGenerator raygenIn[];
};

layout(binding = 2) readonly buffer MaterialsSSBOIn {
    Material materialIn[];
};

layout(binding = 3, rgba8) uniform image2D restirImage;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const int FILTER_RADIUS = 20;
const float SIGMA_SPATIAL = 5.0;
const float SIGMA_NORMAL = 60.0;
const float SIGMA_DEPTH = 0.01;
const float PI = 3.14159265358979323846;

float luminance(vec3 c) {
    return 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b;
}

vec3 lambertian_throughput(in vec3 outgoing, in vec3 normal, in vec3 incoming, in Material material) {
    return ((material.diffuse / PI) +
        (material.specular * (material.shiny + 2.0) /
        (2.0 * PI) * pow(max(dot(reflect(-outgoing, normal), incoming), 0.0), material.shiny))) *
        max(0.0, dot(incoming, normal));
}

vec3 compile_resevoir_at(uint idx) {
    RayGenerator rg = raygenIn[idx];
    if (rg.initial_pdf == 1.0) return rg.spacial_Lo;
    vec3 wi = normalize(rg.spacial_x_s - rg.spacial_x_v);
    vec3 wo = normalize(ubo.position - rg.spacial_x_v);
    vec3 brdf_cos = lambertian_throughput(wo, rg.spacial_n_v, wi, materialIn[rg.initial_mat]);
    vec3 f = brdf_cos * rg.spacial_Lo;
    return f * rg.spacial_W + rg.direct;
}

vec3 filter_pixel(int rx, int ry) {
    uint cIdx = uint(ry) * uint(ubo.width) + uint(rx);
    RayGenerator center = raygenIn[cIdx];
    if (center.initial_n_v == vec3(0.0)) {
        return compile_resevoir_at(cIdx);
    }
    vec3  centre_normal = center.spacial_n_v;
    float centre_depth = length(center.spacial_x_v - ubo.position);
    float centre_conf = clamp(float(center.spacial_M) / float(max(ubo.contributioncap, 1u)), 0.0, 1.0);
    float inv2SigSpatSq = 1.0 / (2.0 * SIGMA_SPATIAL * SIGMA_SPATIAL);
    float inv2SigDepSq = 1.0 / (2.0 * SIGMA_DEPTH   * SIGMA_DEPTH);
    vec3  colour_sum = vec3(0.0);
    float weight_sum = 0.0;
    for (int dy = -FILTER_RADIUS; dy <= FILTER_RADIUS; dy++) {
        for (int dx = -FILTER_RADIUS; dx <= FILTER_RADIUS; dx++) {
            int nx = rx + dx;
            int ny = ry + dy;
            if (nx < 0 || nx >= int(ubo.width) || ny < 0 || ny >= int(ubo.height)) continue;
            uint nIdx = uint(ny) * uint(ubo.width) + uint(nx);
            RayGenerator nb = raygenIn[nIdx];
            if (nb.initial_n_v == vec3(0.0)) continue;
            float dist2 = float(dx * dx + dy * dy);
            float w_spatial = exp(-dist2 * inv2SigSpatSq);
            float ndot = max(dot(centre_normal, nb.spacial_n_v), 0.0);
            float w_normal = pow(ndot, SIGMA_NORMAL);
            float nb_depth = length(nb.spacial_x_v - ubo.position);
            float depth_diff = abs(centre_depth - nb_depth) / (centre_depth + EPS);
            float w_depth = exp(-depth_diff * depth_diff * inv2SigDepSq);
            float nb_conf = clamp(float(nb.spacial_M) / float(max(ubo.contributioncap, 1u)), 0.0, 1.0);
            float w_conf = nb_conf;
            float w = w_spatial * w_normal * w_depth * w_conf;
            if (w < EPS) continue;
            vec3 nb_colour = compile_resevoir_at(nIdx);
            colour_sum  += w * nb_colour;
            weight_sum  += w;
        }
    }
    if (weight_sum < EPS) return compile_resevoir_at(cIdx);
    return colour_sum / weight_sum;
}

void main() {
    if ((ubo.filters & (1 << 0)) == 0) return;
    uint pixelCount = uint(ubo.width) * uint(ubo.height);
    if (gl_GlobalInvocationID.x >= pixelCount) return;
    int rx = int(gl_GlobalInvocationID.x % uint(ubo.width));
    int ry = int(gl_GlobalInvocationID.x / uint(ubo.width));
    vec3 color = filter_pixel(rx, ry);
    if (ubo.samples == 0) raygenIn[gl_GlobalInvocationID.x].accumulation = vec3(0.0);
    raygenIn[gl_GlobalInvocationID.x].accumulation += color;
    color = raygenIn[gl_GlobalInvocationID.x].accumulation / float(ubo.samples + 1);
    vec3 hdr = (color * ((color / 20.0) + vec3(1.0))) / (vec3(1.0) + color);
    hdr = pow(hdr, vec3(1.0 / 2.2));
    imageStore(restirImage, ivec2(rx, ry), vec4(hdr, 1.0));
}
